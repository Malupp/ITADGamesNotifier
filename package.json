{
  "name": "itad-games-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "benchmark": "tsx scripts/benchmark.ts",
    "db:local": "wrangler d1 migrations apply itad-notifier --local",
    "db:remote": "wrangler d1 migrations apply itad-notifier --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
